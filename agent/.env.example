# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Convex deployment URL (https://<name>.convex.cloud) and the shared secret the backend checks on ingest/outbox calls.
CONVEX_URL=
AGENT_SECRET=

# Optional phone calls. Needs a dedicated Photon iMessage line (shared-pool lines can't take calls) and a Twilio SIP Domain.
# Set to a random hex string (openssl rand -hex 16) to turn calls on. The agent then serves port 8787, and
# Twilio's "A call comes in" webhook is https://<public URL for localhost:8787>/voice/<VOICE_CALL_TOKEN> (HTTP POST).
VOICE_CALL_TOKEN=
